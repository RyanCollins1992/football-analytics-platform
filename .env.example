# Database
DATABASE_URL="postgresql://user:password@localhost:5432/football_analytics"

# Football data providers
# football-data.org — free tier, register at https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=
FOOTBALL_DATA_ORG_BASE_URL="https://api.football-data.org/v4"

# API-Football (api-sports.io) — free tier, register at https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"

# Which provider each data domain should prefer — see src/lib/config.ts
DEFAULT_PROVIDER="football-data-org"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
